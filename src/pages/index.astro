---
// src/pages/index.astro — one page Medianeras.
// Secciones: Navbar, Hero, Quiénes (R01), Qué hacemos (R02), Oferta (R03), Contacto (R05), Footer (R06).
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import SectionHero from '../components/SectionHero.astro';
import SectionQuienes from '../components/SectionQuienes.astro';
import SectionQueHacemos from '../components/SectionQueHacemos.astro';
import SectionOferta from '../components/SectionOferta.astro';
import SectionContacto from '../components/SectionContacto.astro';
import SectionTestimonios from '../components/SectionTestimonios.astro';
import SectionSubstack from '../components/SectionSubstack.astro';
import Marquee from '../components/Marquee.astro';
import DivisorFrase from '../components/DivisorFrase.astro';
import Footer from '../components/Footer.astro';
import { getActividades, getEquipo, getConfig, getTestimonios, getSubstack } from '../lib/cms';
import { localBusinessSchema, eventSchema } from '../lib/schema';

const [actividades, equipo, config, testimonios, substack] = await Promise.all([
  getActividades(),
  getEquipo(),
  getConfig(),
  getTestimonios(),
  getSubstack(),
]);

const site = (Astro.site ?? Astro.url).origin;
const jsonLd = [
  localBusinessSchema(config, site),
  ...actividades
    .filter((a) => a.estado !== 'cerrado')
    .map((a) => eventSchema(a, site))
    .filter((e): e is NonNullable<typeof e> => e !== null),
];
---

<Layout
  title="medianeras — espacio cultural de lectura, escritura y pensamiento"
  jsonLd={jsonLd}
>
  <Navbar />
  <main>
    <SectionHero />
     <DivisorFrase /> 
    <SectionQuienes equipo={equipo} config={config} />
    <Marquee />
    <SectionQueHacemos />
    <SectionOferta actividades={actividades} limite={6} conFiltros={false} />
    <SectionTestimonios testimonios={testimonios} />
    <DivisorFrase bg="color-mix(in srgb, var(--color-secondary) 9%, var(--color-cream))" />
    <SectionSubstack
      eyebrow={substack.txt_eyebrow}
      titulo={substack.txt_titulo}
      lead={substack.txt_lead}
      bajada={substack.txt_bajada}
      ctaLabel={substack.btn_cta.txt_label}
      ctaUrl={substack.btn_cta.link_url}
    />
    <Marquee />
    <SectionContacto config={config} />
  </main>
  <Footer config={config} />
</Layout>
