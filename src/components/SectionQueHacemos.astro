---
import type { Publico } from '../lib/cms';

interface Props {
  publicos: Publico[];
}
const { publicos } = Astro.props;

const COLOR_TOKEN: Record<string, string> = {
  'niños':   'var(--color-audiencia-kids)',
  'juvenil': 'var(--color-audiencia-juvenil)',
  'adultos': 'var(--color-audiencia-medianeras)',
};
---
<section class="seccion seccion--oscura que-hacemos" id="que-hacemos" aria-label="Nuestros públicos">
  <div class="contenedor">
    <ul class="qh__publicos">
      {publicos.map((p) => (
        <li class="publico" style={`--underline-c: ${COLOR_TOKEN[p.audiencia] ?? 'var(--color-audiencia-medianeras)'}`}>
          {p.foto && (
            <div class="publico__foto-wrap">
              <img class="publico__foto" src={p.foto} alt={p.nombre} loading="lazy" />
            </div>
          )}
          {p.sello && (
            <img class="publico__sello" src={p.sello} alt="" aria-hidden="true" loading="lazy" width="80" height="80" />
          )}
          <div class="publico__body">
            <h3 class="publico__nombre">{p.nombre}</h3>
            <p class="publico__texto">{p.descripcion}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .qh__publicos {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .publico {
    position: relative;
    background: color-mix(in srgb, var(--color-cream) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-secondary) 30%, transparent);
    border-radius: var(--radius-card);
    overflow: hidden;
  }

  .publico__sello {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 80px;
    height: 80px;
    object-fit: contain;
    z-index: 1;
  }

  .publico__foto-wrap {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .publico__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .publico__body {
    padding: var(--space-5) var(--space-5) var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .publico__nombre {
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--text-on-dark);
    margin: 0;
    text-decoration: underline;
    text-decoration-color: var(--underline-c, var(--color-audiencia-kids));
    text-decoration-thickness: 4px;
    text-underline-offset: 5px;
  }

  .publico__texto {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-cream) 80%, transparent);
    margin: 0;
  }

  @media (max-width: 900px) {
    .qh__publicos { grid-template-columns: repeat(2, 1fr); }
    .publico:last-child {
      grid-column: 1 / -1;
      max-width: 420px;
      margin-inline: auto;
      width: 100%;
    }
  }

  @media (max-width: 560px) {
    .qh__publicos { grid-template-columns: 1fr; }
    .publico:last-child { grid-column: auto; max-width: none; }
  }
</style>
