---
// ActividadCard.astro — card de actividad inspirada en el estilo visual de IG stories.
// Banda superior de color por categoría. Fecha prominente. Múltiples docentes.
import FloralIcon from './FloralIcon.astro';
import { UI } from '../content/ui';
import { primeraFecha, formatPrecio, labelModalidad, fechaIg } from '../lib/format';
import type { Actividad } from '../lib/types';

interface Props {
  actividad: Actividad;
}
const { actividad: a } = Astro.props;

const primerFechaObj = a.fechas[0];
const ig = primerFechaObj ? fechaIg(primerFechaObj) : null;
const horaLabel = ig
  ? primerFechaObj?.duracion ? `${ig.hora} · ${primerFechaObj.duracion} min` : `${ig.hora} hs`
  : null;

const precio = formatPrecio(a.precio);
const esContenido = a.categoria === 'contenido-gratuito';
const cerrado = a.estado === 'cerrado';
const proximamente = a.estado === 'proximamente';

// Todos los docentes o el principal
const docenteLabel = a.docentes?.length
  ? a.docentes.map((d) => d.nombre).join(' · ')
  : a.docente.nombre;

const ICONO_CAT: Record<string, 'flor' | 'margarita' | 'hoja' | 'rama'> = {
  taller: 'flor',
  encuentro: 'margarita',
  'club-lectura': 'hoja',
  capacitacion: 'rama',
  'contenido-gratuito': 'hoja',
};
const icono = ICONO_CAT[a.categoria] ?? 'flor';

const ctaLabel = esContenido ? UI.actividad.descargar : UI.actividad.inscribirse;

const AUDIENCIA_MAP: Record<string, { label: string; svg: string }> = {
  niños:   { label: 'Medianeras Kids',    svg: '/brand/kids-circulo-claro.png' },
  juvenil: { label: 'Medianeras Juvenil', svg: '/brand/juvenil-circulo-claro.png' },
  adultos: { label: 'Medianeras',         svg: '/brand/svg_elements/circle/amamos_leer_2.svg' },
};
const aud = a.audiencia ? AUDIENCIA_MAP[a.audiencia] : null;
---
<article class="card" data-categoria={a.categoria} data-audiencia={a.audiencia} data-destacada={a.destacada}>
  <!-- Banda superior de color (referencia IG story) -->
  <div class="card__banda">
    {ig ? (
      <div class="card__fecha-bloque">
        <span class="card__dia">{ig.dia}</span>
        <span class="card__diasem">{ig.diaSem}</span>
      </div>
      <div class="card__divider" aria-hidden="true"></div>
      <div class="card__fecha-info">
        {horaLabel && <span class="card__horario-badge">{horaLabel}</span>}
        <span class="tag tag--modalidad">{labelModalidad(a.modalidad)}</span>
      </div>
    ) : (
      <div class="card__sin-fecha">
        <span class="tag tag--modalidad">{labelModalidad(a.modalidad)}</span>
      </div>
    )}
    <span class="card__icono-deco" aria-hidden="true">
      {aud
        ? <img src={aud.svg} alt="" width="64" height="64" loading="lazy" />
        : <FloralIcon variante={icono} color="currentColor" size={64} />
      }
    </span>
  </div>

  <!-- Cuerpo -->
  <div class="card__body">
    <h3 class="card__titulo">{a.nombre}</h3>

    <p class="card__docente">
      <span class="card__dicta">{UI.actividad.coordina}</span> {docenteLabel}
    </p>

    <p class="card__desc">{a.descripcion}</p>

    <div class="card__pie">
      {cerrado ? (
        <span class="tag tag--cerrado">{UI.actividad.sinCupos}</span>
      ) : proximamente ? (
        <span class="tag tag--proximamente">{UI.actividad.proximamente}</span>
      ) : esContenido ? (
        <a class="boton" href="#contacto">{ctaLabel}</a>
      ) : (
        <button
          class="boton js-inscribirse"
          data-id={a.id}
          data-nombre={a.nombre}
          data-precio={precio}
          data-whatsapp={a.whatsapp ?? ''}
          data-extra-fields={JSON.stringify(a.extraFields ?? [])}
        >
          {ctaLabel}
        </button>
      )}
    </div>
  </div>
</article>

<style>
  /* ── Estructura ──────────────────────────────────────────────────────── */
  .card {
    display: flex;
    flex-direction: column;
    background: var(--color-cream);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
    border: 2px solid color-mix(in srgb, var(--color-secondary) 40%, transparent);
    overflow: hidden;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }
  .card:hover {
    box-shadow: var(--shadow-modal);
  }
  .card[data-destacada='true'] {
    box-shadow: var(--shadow-card);
  }

  /* ── Banda superior: paleta real por tipo de propuesta ──────────────────
     encuentro   → teal oscuro  ("el azul" de la paleta)
     taller      → mostaza      (amarillo)
     capacitacion→ rojo-naranja
     contenido   → oliva verde
  ──────────────────────────────────────────────────────────────────────── */
  .card__banda {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    min-height: 72px;
    background: var(--color-cream);
    color: var(--text-main);
    border-bottom: 4px solid var(--color-secondary);
    position: relative;
  }

  /* Banda y borde por audiencia */
  .card[data-audiencia='niños']   .card__banda { border-bottom-color: var(--color-audiencia-kids); }
  .card[data-audiencia='juvenil'] .card__banda { border-bottom-color: var(--color-audiencia-juvenil); }
  .card[data-audiencia='adultos'] .card__banda { border-bottom-color: var(--color-audiencia-medianeras); }

  .card[data-audiencia='niños']   { border: 2px solid var(--color-audiencia-kids); }
  .card[data-audiencia='juvenil'] { border: 2px solid var(--color-audiencia-juvenil); }
  .card[data-audiencia='adultos'] { border: 2px solid var(--color-audiencia-medianeras); }

  .card[data-audiencia='niños']   .boton { background: var(--color-audiencia-kids);       color: var(--color-primary); border-color: var(--color-audiencia-kids); }
  .card[data-audiencia='juvenil'] .boton { background: var(--color-audiencia-juvenil);    color: var(--color-cream);   border-color: var(--color-audiencia-juvenil); }
  .card[data-audiencia='adultos'] .boton { background: var(--color-audiencia-medianeras); color: var(--color-primary); border-color: var(--color-audiencia-medianeras); }

  /* ── Fecha tipo IG ───────────────────────────────────────────────────── */
  .card__fecha-bloque {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    flex-shrink: 0;
  }
  .card__dia {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1;
  }
  .card__diasem {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    opacity: 0.9;
  }
  .card__divider {
    width: 1px;
    height: 40px;
    background: currentColor;
    opacity: 0.3;
    flex-shrink: 0;
  }
  .card__fecha-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .card__horario-badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.6;
  }
  .card__sin-fecha {
    display: flex;
    align-items: center;
  }
  .card__icono-deco {
    margin-left: auto;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
  }
  .card__icono-deco img {
    width: 64px;
    height: auto;
    display: block;
  }

  /* Tags en banda: sin fondo, solo texto */
  .card__banda .tag--modalidad {
    background: none;
    border: none;
    color: currentColor;
    padding: 0;
  }

  /* ── Cuerpo ──────────────────────────────────────────────────────────── */
  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    flex: 1;
  }
  .card__titulo {
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-main);
    text-decoration: underline;
    text-decoration-thickness: 3px;
    text-underline-offset: 5px;
    text-decoration-color: color-mix(in srgb, var(--color-secondary) 50%, transparent);
  }
  .card[data-audiencia='niños']   .card__titulo { text-decoration-color: var(--color-audiencia-kids); }
  .card[data-audiencia='juvenil'] .card__titulo { text-decoration-color: var(--color-audiencia-juvenil); }
  .card[data-audiencia='adultos'] .card__titulo { text-decoration-color: var(--color-audiencia-medianeras); }
  .card__docente {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .card__dicta {
    font-weight: 600;
    color: var(--text-main);
  }
  .card__desc {
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: 1.55;
  }
  .card__pie {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-3);
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1px solid color-mix(in srgb, var(--color-secondary) 25%, transparent);
  }
</style>
