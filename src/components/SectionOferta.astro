---
// SectionOferta.astro — foco comercial (R03). Filtros multi-dimensión + grilla + modal.
import ActividadCard from './ActividadCard.astro';
import ModalInscripcion from './ModalInscripcion.astro';
import FloralIcon from './FloralIcon.astro';
import { UI } from '../content/ui';
import type { Actividad, Categoria, Audiencia } from '../lib/types';

interface Props {
  actividades: Actividad[];
  limite?: number;
  conBusqueda?: boolean;
  conFiltros?: boolean;
  titulo?: string;
}
const { actividades, limite, conBusqueda = false, conFiltros = true, titulo } = Astro.props;

function fechaProxima(a: Actividad): string {
  return [...a.fechas].map((f) => f.fecha).sort()[0] ?? '9999-12-31';
}

// En home (limite): próximas por fecha. En página completa: destacadas primero.
const ordenadas = limite
  ? [...actividades]
      .sort((a, b) => fechaProxima(a).localeCompare(fechaProxima(b)))
      .slice(0, limite)
  : [...actividades].sort((a, b) => {
      if (a.destacada !== b.destacada) return a.destacada ? -1 : 1;
      return b.publishedAt.localeCompare(a.publishedAt);
    });

// Chips de categoría — solo las presentes, label dinámico desde CMS
const categoriasPresentes = [...new Set(actividades.map((a) => a.categoria))] as Categoria[];
const catLabelMap = new Map<string, string>(
  actividades.filter((a) => a.categoriaNombre).map((a) => [a.categoria, a.categoriaNombre!]),
);
const ORDEN_CAT: Categoria[] = ['taller', 'encuentro', 'club-lectura', 'capacitacion', 'contenido-gratuito'];
const FILTROS_CAT = [
  { value: 'todas', label: UI.filtros.todas },
  ...ORDEN_CAT
    .filter((c) => categoriasPresentes.includes(c))
    .map((c) => ({ value: c, label: catLabelMap.get(c) ?? UI.filtros[c] })),
  ...categoriasPresentes
    .filter((c) => !ORDEN_CAT.includes(c as Categoria))
    .map((c) => ({ value: c, label: catLabelMap.get(c) ?? c })),
];

// Chips de audiencia — solo las presentes
const audienciasPresentes = [...new Set(actividades.map((a) => a.audiencia ?? 'adultos'))] as Audiencia[];
const ORDEN_AUD: Audiencia[] = ['niños', 'juvenil', 'adultos'];
const FILTROS_AUD = audienciasPresentes.length >= 1
  ? [
      { value: 'todas', label: UI.filtrosAudiencia.todas },
      ...ORDEN_AUD
        .filter((a) => audienciasPresentes.includes(a))
        .map((a) => ({ value: a, label: UI.filtrosAudiencia[a] })),
    ]
  : [];

const AUDIENCIA_ICONO: Record<string, { icono: 'flor' | 'margarita' | 'hoja'; color: string }> = {
  niños:   { icono: 'flor',      color: 'var(--color-yellow)' },
  juvenil: { icono: 'margarita', color: 'var(--color-red)' },
  adultos: { icono: 'hoja',      color: 'var(--color-olive)' },
};

---
<section class="seccion oferta" id="talleres" aria-labelledby="oferta-titulo">
  <div class="contenedor">
    {!titulo && <p class="eyebrow">Qué ofrecemos</p>}
    <h2 id="oferta-titulo" class="label-seccion">{titulo ?? 'Propuestas'}</h2>

    {(conBusqueda || conFiltros) && (
      <div class="oferta__controles">
        {conFiltros && (
          <div class="oferta__filtros-barra">

            <!-- Chips: Audiencia -->
            {FILTROS_AUD.length > 0 && (
              <div class="aud-chips" role="group" aria-label="Filtrar por audiencia">
                {FILTROS_AUD.map((f, i) => (
                  <button class={`aud-chip${i === 0 ? ' aud-chip--activo' : ''}`} type="button" data-aud={f.value}>
                    {f.label}
                  </button>
                ))}
              </div>
            )}

            <!-- Dropdown: Categoría -->
            <div class="of-drop" data-drop="cat">
              <button class="of-drop__btn" type="button" aria-expanded="false" aria-haspopup="listbox">
                <span class="of-drop__label">Categoría</span>
                <span class="of-drop__valor">{FILTROS_CAT[0]?.label}</span>
                <svg class="of-drop__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <ul class="of-drop__menu" role="listbox" aria-label="Categoría">
                {FILTROS_CAT.map((f, i) => (
                  <li class={`of-drop__op${i === 0 ? ' of-drop__op--sel' : ''}`} role="option" data-value={f.value} aria-selected={i === 0 ? 'true' : 'false'}>
                    {f.label}
                  </li>
                ))}
              </ul>
            </div>

            <!-- Dropdown: Costo -->
            <div class="of-drop" data-drop="costo">
              <button class="of-drop__btn" type="button" aria-expanded="false" aria-haspopup="listbox">
                <span class="of-drop__label">Costo</span>
                <span class="of-drop__valor">{Object.values(UI.filtrosCosto)[0]}</span>
                <svg class="of-drop__chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
              <ul class="of-drop__menu" role="listbox" aria-label="Costo">
                {Object.entries(UI.filtrosCosto).map(([val, label], i) => (
                  <li class={`of-drop__op${i === 0 ? ' of-drop__op--sel' : ''}`} role="option" data-value={val} aria-selected={i === 0 ? 'true' : 'false'}>
                    {label}
                  </li>
                ))}
              </ul>
            </div>

          </div>
        )}
        {conBusqueda && (
          <input
            type="search"
            id="oferta-search"
            class="oferta__search-input"
            placeholder="Buscar…"
            aria-label="Buscar propuestas"
          />
        )}
      </div>
    )}

    <ul class="oferta__grid" id="oferta-grid">
      {ordenadas.map((a) => (
        <li
          data-categoria={a.categoria}
          data-audiencia={a.audiencia ?? 'adultos'}
          data-precio={!a.precio ? 'gratuito' : 'pago'}
          data-fecha-proxima={fechaProxima(a)}
          data-titulo={a.nombre.toLowerCase()}
          data-descripcion={a.descripcion.toLowerCase()}
        >
          <ActividadCard actividad={a} />
        </li>
      ))}
    </ul>

    <p class="oferta__vacio" id="oferta-vacio" hidden></p>

    {limite && (
      <div class="oferta__ver-todas">
        <a class="boton boton--secundario" href="/talleres">Ver todos los talleres</a>
      </div>
    )}
  </div>
</section>

<ModalInscripcion />

<script>
  import { actions } from 'astro:actions';
  import { UI } from '../content/ui';

  // ── Estado de filtros ────────────────────────────────────────────────
  let activeCat = 'todas';
  let activeAud = 'todas';
  let activeCosto = 'todos';
  let activeBusqueda = '';

  const items = () => Array.from(document.querySelectorAll<HTMLLIElement>('#oferta-grid > li'));
  const vacio = document.querySelector<HTMLElement>('#oferta-vacio');
  const LABELS: Record<string, string> = {
    taller: 'talleres',
    encuentro: 'encuentros',
    'club-lectura': 'clubs de lectura',
    capacitacion: 'capacitaciones',
    'contenido-gratuito': 'contenido gratuito',
  };

  function aplicarFiltros() {
    let visibles = 0;
    items().forEach((li) => {
      const okCat      = activeCat      === 'todas' || li.dataset.categoria === activeCat;
      const okAud      = activeAud      === 'todas' || li.dataset.audiencia === activeAud;
      const okCosto    = activeCosto    === 'todos' || li.dataset.precio    === activeCosto;
      const okBusqueda = !activeBusqueda ||
        li.dataset.titulo?.includes(activeBusqueda) ||
        li.dataset.descripcion?.includes(activeBusqueda);
      const ok = okCat && okAud && okCosto && okBusqueda;
      li.hidden = !ok;
      if (ok) visibles++;
    });
    if (vacio) {
      vacio.hidden = visibles > 0;
      if (visibles === 0) {
        const label = activeCat !== 'todas' ? LABELS[activeCat] ?? 'propuestas' : 'propuestas';
        vacio.textContent = UI.empty.sinActividades(label);
      }
    }
  }

  // ── Búsqueda ─────────────────────────────────────────────────────────
  const searchInput = document.querySelector<HTMLInputElement>('#oferta-search');
  searchInput?.addEventListener('input', () => {
    activeBusqueda = (searchInput.value ?? '').toLowerCase().trim();
    aplicarFiltros();
  });

  // ── Dropdowns custom ─────────────────────────────────────────────────
  function cerrarTodos() {
    document.querySelectorAll<HTMLButtonElement>('.of-drop__btn').forEach((b) =>
      b.setAttribute('aria-expanded', 'false')
    );
  }

  function setupDrop(drop: HTMLElement, onChange: (val: string) => void) {
    const btn   = drop.querySelector<HTMLButtonElement>('.of-drop__btn')!;
    const label = drop.querySelector<HTMLElement>('.of-drop__valor')!;
    const ops   = Array.from(drop.querySelectorAll<HTMLElement>('.of-drop__op'));

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const abierto = btn.getAttribute('aria-expanded') === 'true';
      cerrarTodos();
      btn.setAttribute('aria-expanded', String(!abierto));
    });

    ops.forEach((op) => {
      op.addEventListener('click', () => {
        const val = op.dataset.value ?? '';
        ops.forEach((o) => {
          o.classList.toggle('of-drop__op--sel', o === op);
          o.setAttribute('aria-selected', String(o === op));
        });
        label.textContent = op.textContent?.trim() ?? '';
        btn.classList.toggle('of-drop__btn--activo', op !== ops[0]);
        cerrarTodos();
        onChange(val);
      });
    });
  }

  document.addEventListener('click', cerrarTodos);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') cerrarTodos(); });

  const dropCat   = document.querySelector<HTMLElement>('.of-drop[data-drop="cat"]');
  const dropCosto = document.querySelector<HTMLElement>('.of-drop[data-drop="costo"]');

  if (dropCat)   setupDrop(dropCat,   (v) => { activeCat   = v; aplicarFiltros(); });
  if (dropCosto) setupDrop(dropCosto, (v) => { activeCosto = v; aplicarFiltros(); });

  // Chips de audiencia
  document.querySelectorAll<HTMLButtonElement>('.aud-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('.aud-chip').forEach((c) => c.classList.remove('aud-chip--activo'));
      chip.classList.add('aud-chip--activo');
      activeAud = chip.dataset.aud ?? 'todas';
      aplicarFiltros();
    });
  });

  // ── Modal de inscripción ─────────────────────────────────────────────
  const modal         = document.querySelector<HTMLDialogElement>('#modal-inscripcion');
  const form          = document.querySelector<HTMLFormElement>('#form-inscripcion');
  const panelForm     = modal?.querySelector<HTMLElement>('[data-estado="form"]');
  const panelSucc     = modal?.querySelector<HTMLElement>('[data-estado="success"]');
  const titulo        = document.querySelector<HTMLElement>('#modal-titulo');
  const errorEl       = modal?.querySelector<HTMLElement>('[data-error]');
  const idInput       = form?.querySelector<HTMLInputElement>('input[name="actividadId"]');
  const nombreInput   = form?.querySelector<HTMLInputElement>('input[name="actividadNombre"]');
  const precioInput   = form?.querySelector<HTMLInputElement>('input[name="actividadPrecio"]');
  const precioDisplay = modal?.querySelector<HTMLElement>('[data-precio-display]');
  const pagoEl        = modal?.querySelector<HTMLElement>('.modal__pago');
  const camposEl      = modal?.querySelector<HTMLElement>('#modal-campos');
  const fallbackLink  = panelSucc?.querySelector<HTMLAnchorElement>('.modal__wa-fallback');

  const WA_FALLBACK = '543492620920';

  interface ExtraField { id: string; type: string; label: string; placeholder?: string; required: boolean; }
  let currentFields: Array<{ id: string; label: string }> = [];
  let currentWaNumber = '';

  const AC: Record<string, string> = { nombre: 'name', telefono: 'tel', email: 'email' };

  function escH(s: string) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function renderCampos(fields: ExtraField[]) {
    if (!camposEl) return;
    camposEl.innerHTML = fields.map((f) => `
      <label class="campo">
        <span>${escH(f.label)}${!f.required ? ' <span class="campo__opcional">(opcional)</span>' : ''}</span>
        <input type="${f.type}" name="${escH(f.id)}" ${f.required ? 'required' : ''} ${f.placeholder ? `placeholder="${escH(f.placeholder)}"` : ''} ${f.type === 'number' ? 'inputmode="numeric"' : ''} autocomplete="${AC[f.id] ?? 'off'}" />
      </label>`).join('');
  }

  function abrir(id: string, nombre: string, precio: string, waNumber: string, extraFieldsRaw: string) {
    if (!modal || !form) return;

    const extra: ExtraField[] = JSON.parse(extraFieldsRaw || '[]');
    const fixed: ExtraField[] = [
      { id: 'nombre',   type: 'text', label: 'Nombre completo',     required: true },
      { id: 'telefono', type: 'tel',  label: 'Teléfono / WhatsApp', required: true },
    ];
    const allFields = [...fixed, ...extra];
    currentFields   = allFields.map((f) => ({ id: f.id, label: f.label }));
    currentWaNumber = waNumber;

    form.reset();
    idInput!.value = id;
    nombreInput!.value = nombre;
    if (precioInput) precioInput.value = precio;
    if (precioDisplay) precioDisplay.textContent = precio;
    if (pagoEl) pagoEl.hidden = !precio || precio === 'Gratuito';
    if (titulo) titulo.textContent = UI.modal.titulo(nombre);
    if (errorEl) errorEl.hidden = true;

    renderCampos(allFields);

    const waNum = (waNumber || WA_FALLBACK).replace(/^\+/, '');
    if (fallbackLink) {
      fallbackLink.href = `https://wa.me/${waNum}`;
      const strong = fallbackLink.querySelector('strong');
      if (strong) strong.textContent = waNum;
    }

    panelForm!.hidden = false;
    panelSucc!.hidden = true;
    modal.showModal();
  }

  document.querySelectorAll<HTMLButtonElement>('.js-inscribirse').forEach((btn) =>
    btn.addEventListener('click', () =>
      abrir(
        btn.dataset.id ?? '',
        btn.dataset.nombre ?? '',
        btn.dataset.precio ?? '',
        btn.dataset.whatsapp ?? '',
        btn.dataset.extraFields ?? '[]',
      ),
    ),
  );

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.checkValidity()) { form.reportValidity(); return; }

    const data            = new FormData(form);
    const actividadId     = data.get('actividadId') as string;
    const actividadNombre = data.get('actividadNombre') as string;

    const msgLines = currentFields.map((f) => `*${f.label}:* ${data.get(f.id) ?? ''}`).join('\n');
    const msg      = `Hola! Me quiero preinscribir a *"${actividadNombre}"*.\n\n${msgLines}`;
    const waNum    = (currentWaNumber || WA_FALLBACK).replace(/^\+/, '');
    window.open(`https://wa.me/${waNum}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');

    panelForm!.hidden = true;
    panelSucc!.hidden = false;

    // POST al CMS — fire-and-forget, no bloquea el flujo WA
    const apiBase    = import.meta.env.PUBLIC_CMS_API;
    const clientSlug = import.meta.env.PUBLIC_CLIENT_SLUG;
    if (apiBase && actividadId) {
      const body: Record<string, string> = { _hp: '' };
      currentFields.forEach(({ id }) => {
        const v = data.get(id);
        if (v != null) body[id] = v as string;
      });
      fetch(
        `${apiBase}/activities/${actividadId}/register?clientSlug=${encodeURIComponent(clientSlug ?? '')}`,
        { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) },
      ).catch(() => {});
    }
  });
</script>

<style>
  /* ── Barra de controles sticky ──────────────────────────────────────── */
  .oferta__controles {
    position: sticky;
    top: 64px;
    z-index: 20;
    background: var(--color-cream);
    margin-inline: calc(-1 * var(--container-px));
    padding-inline: var(--container-px);
    padding-block: var(--space-4);
    border-bottom: 1px solid color-mix(in srgb, var(--color-secondary) 22%, transparent);
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .oferta__search-input {
    margin-left: auto;
    width: min(220px, 100%);
    padding: var(--space-2) var(--space-5);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: var(--radius-pill);
    background: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-body);
    color: var(--text-main);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .oferta__search-input:focus {
    outline: none;
    border-color: var(--color-secondary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-secondary) 25%, transparent);
  }
  .oferta__search-input::placeholder { color: var(--text-muted); }

  .oferta {
    border-bottom: 5px solid var(--color-yellow);
  }

  /* ── Fila de dropdowns ───────────────────────────────────────────────── */
  .oferta__filtros-barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .of-drop {
    position: relative;
  }

  .of-drop__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1.5px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
    border-radius: var(--radius-pill);
    background: #fff;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-main);
    cursor: pointer;
    min-height: 40px;
    white-space: nowrap;
    transition: border-color var(--transition-fast), background var(--transition-fast), color var(--transition-fast);
  }
  .of-drop__btn:hover {
    border-color: var(--color-primary);
  }
  .of-drop__btn[aria-expanded="true"] {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 6%, #fff);
  }
  .of-drop__btn--activo {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-cream);
  }
  .of-drop__btn--activo:hover,
  .of-drop__btn--activo[aria-expanded="true"] {
    background: color-mix(in srgb, var(--color-primary) 88%, #000);
    border-color: var(--color-primary);
  }

  .of-drop__label {
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    opacity: 0.75;
  }
  .of-drop__btn--activo .of-drop__label {
    color: inherit;
    opacity: 0.7;
  }

  .of-drop__chevron {
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }
  .of-drop__btn[aria-expanded="true"] .of-drop__chevron {
    transform: rotate(180deg);
  }

  .of-drop__menu {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    min-width: 100%;
    background: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-primary) 18%, transparent);
    border-radius: var(--radius-md);
    box-shadow: 0 4px 24px rgba(41, 72, 76, 0.13);
    list-style: none;
    padding: var(--space-2) 0;
    margin: 0;
    z-index: 30;
  }
  .of-drop__btn[aria-expanded="true"] ~ .of-drop__menu {
    display: block;
  }

  .of-drop__op {
    padding: var(--space-2) var(--space-5);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-main);
    cursor: pointer;
    white-space: nowrap;
    transition: background var(--transition-fast), color var(--transition-fast);
  }
  .of-drop__op:hover {
    background: color-mix(in srgb, var(--color-secondary) 22%, transparent);
  }
  .of-drop__op--sel {
    font-weight: 700;
    color: var(--color-primary);
    background: color-mix(in srgb, var(--color-secondary) 14%, transparent);
  }

  .oferta__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .oferta__grid > li {
    display: flex;
  }
  .oferta__grid > li > :global(.card) {
    width: 100%;
  }
  .oferta__ver-todas {
    display: flex;
    justify-content: center;
    margin-top: var(--space-7);
  }

  .oferta__vacio {
    margin-top: var(--space-6);
    font-size: var(--text-body-lg);
    color: var(--text-muted);
  }

  /* ── Chips de audiencia ──────────────────────────────────────────────── */
  .aud-chips {
    display: flex;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
  }
  .aud-chip {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: var(--space-2) var(--space-3);
    background: none;
    border: none;
    border-bottom: 3px solid transparent;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: color var(--transition-fast), border-color var(--transition-fast);
    white-space: nowrap;
    line-height: 1.4;
  }
  /* Todos los chips muestran su color (tenue) */
  .aud-chip[data-aud="todas"]   { border-bottom-color: color-mix(in srgb, var(--color-primary) 35%, transparent); }
  .aud-chip[data-aud="niños"]   { border-bottom-color: color-mix(in srgb, var(--color-yellow) 55%, transparent); }
  .aud-chip[data-aud="juvenil"] { border-bottom-color: color-mix(in srgb, var(--color-red) 55%, transparent); }
  .aud-chip[data-aud="adultos"] { border-bottom-color: color-mix(in srgb, var(--color-olive) 55%, transparent); }
  .aud-chip:hover { color: var(--text-main); }
  /* Activo: color pleno + texto destacado */
  .aud-chip--activo { color: var(--text-main); }
  .aud-chip--activo[data-aud="todas"]   { border-bottom-color: var(--color-primary); }
  .aud-chip--activo[data-aud="niños"]   { border-bottom-color: var(--color-yellow); }
  .aud-chip--activo[data-aud="juvenil"] { border-bottom-color: var(--color-red); }
