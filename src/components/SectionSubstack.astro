---
// SectionSubstack.astro — Invitación al newsletter en Substack. Datos desde CMS.
interface Props {
  eyebrow: string;
  titulo: string;
  lead: string;
  bajada: string;
  ctaLabel: string;
  ctaUrl: string;
}
const { eyebrow, titulo, lead, bajada, ctaLabel, ctaUrl } = Astro.props;
---
<section class="seccion substack" aria-labelledby="substack-titulo">
  <div class="contenedor substack__inner">
    <div class="substack__contenido">
      <img class="substack__icono" src="/brand/substack.png" alt="Substack" width="48" height="48" loading="lazy" />
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="substack-titulo" class="substack__titulo">{titulo}</h2>
      <p class="substack__lead">{lead}</p>
      <p class="substack__texto">{bajada}</p>
      <a
        class="boton substack__cta"
        href={ctaUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>

<style>
  .substack {
    background: color-mix(in srgb, var(--color-secondary) 9%, var(--color-cream));
    text-align: center;
  }

  .substack__inner {
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
  }

  .substack__contenido {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .substack__titulo {
    font-size: var(--text-h2);
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
  }

  .substack__lead {
    font-size: var(--text-body-lg);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
  }

  .substack__texto {
    font-size: var(--text-body-lg);
    font-style: italic;
    color: var(--text-muted);
    margin: 0;
  }

  .substack__icono {
    flex-shrink: 0;
  }

  .substack__cta {
    margin-top: var(--space-2);
  }
</style>
