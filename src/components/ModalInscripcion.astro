---
// ModalInscripcion.astro — <dialog> nativo. Submit → WhatsApp.
import { UI } from '../content/ui';
---
<dialog class="modal" id="modal-inscripcion" aria-labelledby="modal-titulo">
  <form method="dialog" class="modal__cerrar-wrap">
    <button class="modal__cerrar" value="cancel" aria-label="Cerrar">×</button>
  </form>

  <!-- Estado: formulario -->
  <div class="modal__panel" data-estado="form">
    <h2 id="modal-titulo" class="label-seccion">Inscripción</h2>

    <form class="modal__form" id="form-inscripcion" novalidate>
      <input type="hidden" name="actividadId" value="" />
      <input type="hidden" name="actividadNombre" value="" />

      <label class="campo">
        <span>Nombre completo</span>
        <input type="text" name="nombre" required minlength="2" autocomplete="name" />
      </label>

      <label class="campo">
        <span>Email</span>
        <input type="email" name="email" required autocomplete="email" />
      </label>

      <label class="campo">
        <span>DNI</span>
        <input type="text" name="dni" required inputmode="numeric" placeholder="Ej: 38123456" />
      </label>

      <div class="modal__pago">
        <p class="modal__pago-titulo">Datos de pago</p>
        <p class="modal__pago-fila"><span>Alias:</span><strong>medianeras.lecturas</strong></p>
        <p class="modal__aviso">Compartí el comprobante de pago por WhatsApp para asegurar tu lugar en el taller.</p>
      </div>

      <p class="modal__error" data-error hidden></p>

      <button type="submit" class="boton modal__submit">
        <svg class="modal__wa-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        Inscribirme
      </button>
    </form>
  </div>

  <!-- Estado: éxito -->
  <div class="modal__panel" data-estado="success" hidden>
    <h2 class="label-seccion">¡Casi listo!</h2>
    <p class="modal__success-msg">Tu inscripción continúa por WhatsApp. Enviá el comprobante de pago para confirmar tu lugar en el taller.</p>
    <p class="modal__success-fallback">¿No se abrió WhatsApp? Escribinos al <a href="https://wa.me/5493492646942" target="_blank" rel="noopener"><strong>3492 646942</strong></a>.</p>
    <form method="dialog"><button class="boton" id="modal-success-cerrar">Listo</button></form>
  </div>
</dialog>

<style>
  .modal {
    width: min(92vw, 460px);
    max-height: 90svh;
    overflow-y: auto;
    border: none;
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    background: var(--color-cream);
    color: var(--text-main);
    box-shadow: var(--shadow-modal);
    position: fixed;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    margin: 0;
  }
  .modal::backdrop {
    background: color-mix(in srgb, var(--color-primary) 55%, transparent);
    backdrop-filter: blur(2px);
  }
  .modal__cerrar-wrap {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    margin: 0;
  }
  .modal__cerrar {
    width: 36px;
    height: 36px;
    border: none;
    background: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--text-main);
    border-radius: var(--radius-pill);
  }
  .modal__cerrar:hover {
    background: color-mix(in srgb, var(--color-secondary) 30%, transparent);
  }
  .modal__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .campo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .campo input {
    font-family: var(--font-sans);
    font-size: var(--text-body);
    padding: var(--space-3);
    border: 2px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--text-main);
  }
  .campo input:focus {
    outline: none;
    border-color: var(--color-primary);
  }

  .modal__pago {
    background: color-mix(in srgb, var(--color-yellow) 15%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-yellow) 50%, transparent);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .modal__pago-titulo {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }
  .modal__pago-fila {
    font-size: var(--text-sm);
    margin: 0;
    display: flex;
    gap: var(--space-3);
    color: var(--text-muted);
  }
  .modal__pago-fila strong {
    color: var(--text-main);
  }
  .modal__aviso {
    font-size: var(--text-xs);
    color: var(--color-primary);
    font-weight: 600;
    margin: 0;
    line-height: 1.4;
  }

  .modal__error {
    color: var(--color-red);
    font-size: var(--text-sm);
    font-weight: 600;
    margin: 0;
  }
  .modal__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
  }
  .modal__wa-icon {
    flex-shrink: 0;
  }
  .modal__submit[aria-busy='true'] {
    opacity: 0.7;
    pointer-events: none;
  }
  .modal__success-msg {
    margin: var(--space-5) 0 var(--space-3);
    color: var(--text-muted);
  }
  .modal__success-fallback {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0 0 var(--space-5);
  }
  .modal__success-fallback a {
    color: var(--color-primary);
  }
</style>
